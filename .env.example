# このデプロイが提供しうる機能の上限(lib/appMode.ts)。現在は1デプロイだけなので、
# 通常は未設定(= salonpack。全機能を提供)のままにする。店舗ごとに使える機能は salons.plan で決まる。
# "reviews" にすると、デプロイ全体(全店舗)でブログ・予約通知が止まる。
NEXT_PUBLIC_APP_MODE=
OPENAI_API_KEY=
OPENAI_MODEL=
# 新機能(口コミ生成v2・AI返信)のタスク別モデル(任意。未設定なら OPENAI_MODEL を使う。lib/ai/openai.ts)
OPENAI_MODEL_REVIEW_GENERATION=
OPENAI_MODEL_REVIEW_VERIFICATION=
OPENAI_MODEL_REVIEW_REPAIR=
OPENAI_MODEL_REPLY_GENERATION=
# 口コミ生成のパイプライン。"v2" のときだけ新しい生成(lib/reviewGeneration/pipeline.ts)を使う。
# 未設定・それ以外は v1(Phase 1 より前と同じ生成)。戻すときはこの値を外して再デプロイする。
REVIEW_PIPELINE=
# 口コミ生成のレート制限(任意。未設定なら IP+店舗で10分に20回、店舗ごとに1日300回)。
REVIEW_RATE_LIMIT_IP_SALON_PER_10MIN=
REVIEW_RATE_LIMIT_SALON_PER_DAY=
# v2 で同期の意味検証をしなかった下書きに、計測用の影の検証をかける割合(任意。0〜1、未設定なら0.2)。
REVIEW_SHADOW_VERIFY_RATE=
# レート制限で IP をハッシュにするときの鍵(任意。未設定なら SUPABASE_SERVICE_ROLE_KEY を使う)。
RATE_LIMIT_HASH_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 予約通知機能(/dashboard/notifications, app/api/cron/notifications/poll-mail)
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET は hmail が使っている既存のGoogle OAuth
# Clientをそのまま再利用する想定(PLAN 11節)。Google Cloud Consoleの
# 承認済みリダイレクトURIへreview-app側のURLを追加登録した場合のみ、
# 新規Gmail接続フローで実際に使う(今回のスコープでは新規接続フロー自体は未実装)。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# hmailが使っている既存のLINE公式アカウントのチャネル情報をそのまま再利用する(PLAN 12節)。
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_OA_BASIC_ID=
# review-app専用に新規発行するGmail refresh token暗号化キー(openssl rand -base64 32)。
# hmailのAPP_ENCRYPTION_KEYとは別物 -- 移行スクリプトが一度だけ変換する(PLAN 11節)。
NOTIFICATIONS_ENCRYPTION_KEY=
# app/api/cron/notifications/poll-mail の認証シークレット。hmailのCRON_SECRETとは
# 別物にし、2つのcronエンドポイントを取り違えないようにする。
NOTIFICATIONS_CRON_SECRET=
# Gmail接続が切れたときにLINEで送るアラート文言に含めるリンク用(任意)。
NEXT_PUBLIC_APP_URL=
