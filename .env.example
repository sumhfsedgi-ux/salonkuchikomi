# このデプロイが提供しうる機能の上限(lib/appMode.ts)。現在は1デプロイだけなので、
# 通常は未設定(= salonpack。全機能を提供)のままにする。店舗ごとに使える機能は salons.plan で決まる。
# "reviews" にすると、デプロイ全体(全店舗)でブログ・予約通知が止まる。
NEXT_PUBLIC_APP_MODE=
OPENAI_API_KEY=
OPENAI_MODEL=
# 新機能(口コミ生成v2・AI返信)のタスク別モデル(任意。未設定なら OPENAI_MODEL を使う。lib/ai/openai.ts)
OPENAI_MODEL_REVIEW_GENERATION=
OPENAI_MODEL_REVIEW_VERIFICATION=
OPENAI_MODEL_REVIEW_REPAIR=
OPENAI_MODEL_REPLY_GENERATION=
# 口コミ生成のパイプライン。"v2" のときだけ新しい生成(lib/reviewGeneration/pipeline.ts)を使う。
# 未設定・それ以外は v1(Phase 1 より前と同じ生成)。戻すときはこの値を外して再デプロイする。
REVIEW_PIPELINE=
# 口コミ生成のレート制限(任意。未設定なら IP+店舗で10分に20回、店舗ごとに1日300回)。
REVIEW_RATE_LIMIT_IP_SALON_PER_10MIN=
REVIEW_RATE_LIMIT_SALON_PER_DAY=
# v2 で同期の意味検証をしなかった下書きに、計測用の影の検証をかける割合(任意。0〜1、未設定なら0.2)。
REVIEW_SHADOW_VERIFY_RATE=
# レート制限で IP をハッシュにするときの鍵(任意。未設定なら SUPABASE_SERVICE_ROLE_KEY を使う)。
RATE_LIMIT_HASH_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SalonPack 共通の Google 連携(/dashboard/settings/google、lib/google/*)。
# 予約通知(Gmail の読み取り)と届いた口コミ(Google ビジネスプロフィール)で同じ OAuth クライアントを使い、
# 選んだ機能に必要な権限だけを要求する。hmail の OAuth クライアントは使わない(トークンも移行しない)。
# クライアントは、Google ビジネスプロフィール API の利用申請をした Google Cloud プロジェクトに作る
# (docs/plans/lavi-notification-cutover-plan.md「外部の前提」)。公開ステータスが「テスト」の間は
# refresh token が7日で失効するため、本番では「本番」にする。
# 承認済みリダイレクトURI: <NEXT_PUBLIC_APP_URL>/api/google/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google の refresh token・PKCE の検証値の暗号化鍵(lib/google/tokenBox.ts)。
# 形式: GOOGLE_TOKEN_KEYS="v1:<openssl rand -base64 32 の値>"(鍵を入れ替えるときは ",v2:<新しい鍵>" を足して
# GOOGLE_TOKEN_KEY_CURRENT を v2 にする。古い版は、その版で保存した値が残っている間は消さない)。
GOOGLE_TOKEN_KEYS=
GOOGLE_TOKEN_KEY_CURRENT=
# 届いた口コミの Google 連携(business.manage の要求)を有効にするか。Google の承認を確認するまで設定しない(準備中)。
GOOGLE_REVIEWS_OAUTH_ENABLED=
# LINE 公式アカウント(予約通知・口コミ通知で共用)。長期のチャネルアクセストークンを「再発行」すると、
# 今使っているトークン(旧サービスを含む)が即座に使えなくなる。再発行はしない(v2.1・ステートレスは別枠で発行できる)。
# 実際に送るのは本番だけ。開発(next dev)・テスト用DB・擬似の設定・Vercel のプレビューでは、この値があっても送らない
# (lib/notifications/line/sendPolicy.ts。テスト通知は「送信をシミュレーションしました」になる)。
LINE_CHANNEL_ACCESS_TOKEN=
# 実機確認の「指定宛先へのテスト送信」用(確認が終わったら外す)。1 のときだけ、下に指定した LINE のユーザー ID
# (カンマ区切り)にだけ送り、ほかの宛先には、どの環境でも送らない。テスト用DB・擬似 Google・擬似 LINE ログインの
# 設定があると、このフラグがあっても送らない(そちらが優先)。
LINE_REAL_SEND_VERIFY=
LINE_REAL_SEND_VERIFY_DESTINATIONS=
# スタッフの LINE 通知先の追加(招待 → スタッフ本人の LINE ログイン。lib/notifications/line/login/*)。
# 上の公式アカウントの Messaging API チャネルと「同じプロバイダー」に LINE ログインチャネルを新しく作り、
# コールバック URL を <NEXT_PUBLIC_APP_URL>/api/line/login/callback、「Linked LINE Official Account」に公式アカウントを
# 設定して公開してから、3つを設定する(Messaging API チャネルの Webhook URL・トークンは変更しない)。
# 未設定の間は、通知先の追加は「運営にお問い合わせください」の案内になる(既存の通知先の一覧・ON/OFF は使える)。
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_RECIPIENT_INVITES_ENABLED=
# 運営への問い合わせ先(https: / mailto: / tel:)。設定したときだけ画面にリンクを出す(未設定ならリンクは出さない)。
NEXT_PUBLIC_SUPPORT_CONTACT_URL=
NEXT_PUBLIC_SUPPORT_CONTACT_LABEL=
# app/api/cron/notifications/poll-mail の認証シークレット(hmail の CRON_SECRET とは別物)。
NOTIFICATIONS_CRON_SECRET=
# OAuth の戻り先と、Google 連携が切れたときの LINE の案内のリンクに使う(本番のドメイン)。
NEXT_PUBLIC_APP_URL=
